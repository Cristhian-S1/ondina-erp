# Variables de entorno del frontend (Vite).
# Copia este archivo como `.env` y rellena con los valores de tu proyecto Supabase.
# NUNCA commitees el archivo `.env` real; solo este `.env.example`.

# URL del proyecto Supabase (púbica, llega al navegador)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/publishable de Supabase (pública, llega al navegador)
# Generar en: Supabase Dashboard → Settings → API → Project API keys
VITE_SUPABASE_ANON_KEY=tu-clave-anon-aqui